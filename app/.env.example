# PumpLaunchBot — environment contract
# Copy to .env.local for development; set the same names in the Vercel project for production.
# NEVER commit real values. Nothing here is bundled into the client except the NEXT_PUBLIC_ vars.

# ---------------------------------------------------------------------------
# Solana
# ---------------------------------------------------------------------------
# Mainnet RPC (Helius). Required server-side: DAS metadata, treasury reads and transaction building
# all go through it. This is a SECRET — the URL carries your API key and it must never be inlined into
# the browser bundle. The Vercel CLI enforces this: a NEXT_PUBLIC_ name holding a credential is refused
# unless you explicitly mark it --type config.
SOLANA_RPC_URL="https://mainnet.helius-rpc.com/?api-key="
# Optional, and PUBLIC if you set it: the endpoint the browser wallet uses. Leave it empty and the
# client falls back to the public cluster — fine for development, rate-limited in production.
NEXT_PUBLIC_SOLANA_RPC_URL=""
# Used only when the RPC url is empty (dev fallback, heavily rate limited).
NEXT_PUBLIC_SOLANA_CLUSTER="mainnet-beta"

# ---------------------------------------------------------------------------
# Metadata pinning (Pinata) — mandatory before a launch. pump.fun no longer
# accepts direct metadata uploads: `uri` must be an IPFS URI.
# ---------------------------------------------------------------------------
PINATA_JWT=""
PINATA_API_KEY=""
PINATA_API_SECRET=""
# Optional dedicated gateway. Defaults to https://gateway.pinata.cloud/ipfs
# (ipfs.io now answers a browser-only notice to plain HTTP clients — measured).
PINATA_GATEWAY=""

# ---------------------------------------------------------------------------
# Platform treasury (sponsored launches) — stored ENCRYPTED, never in the clear.
# Create the blob with:
#   SOURCE_ENV=<file-with-the-key> TREASURY_PASSPHRASE='<16+ chars>' node scripts/encrypt-treasury.ts
# ---------------------------------------------------------------------------
TREASURY_KEYPAIR_ENCRYPTED=""        # base64( salt | iv | authTag | ciphertext ) of the 64-byte secret key
TREASURY_KEYPAIR_PASSPHRASE=""       # scrypt passphrase — keep it out of the repo
# Public address shown in the UI. Both names are accepted; PLATFORM_TREASURY_PUBKEY is canonical.
PLATFORM_TREASURY_PUBKEY=""
NEXT_PUBLIC_PLATFORM_TREASURY_PUBKEY=""
# Double gate for sponsored sending: BOTH this and {"live":true} in the request are required.
TREASURY_LIVE="false"

# ---------------------------------------------------------------------------
# Creator fee split (basis points; must sum to exactly 10000, max 10 wallets).
# When no fee receiver is supplied the treasury takes 10000 bps (100%).
# ---------------------------------------------------------------------------
FEE_SHARE_USER_BPS="7000"
FEE_SHARE_PLATFORM_BPS="3000"

# ---------------------------------------------------------------------------
# Launch sending gate. false = build + simulate only; nothing is ever sent.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ENABLE_SEND="false"

# ---------------------------------------------------------------------------
# Platform services (optional until the feature that needs them is live)
# ---------------------------------------------------------------------------
DATABASE_URL=""                   # Neon Postgres — launched tokens, treasury ledger
UPSTASH_REDIS_REST_URL=""         # cache + polling watermarks
UPSTASH_REDIS_REST_TOKEN=""

# ---------------------------------------------------------------------------
# Market data + gas sponsorship
# ---------------------------------------------------------------------------
# Fresh-mint index. Indexes brand-new pump.fun mints before DexScreener does — the Launched tab's
# live feed uses it. Without it that feed shows its "tracker returned nothing" notice, honestly.
SOLANATRACKER_API_KEY=""
# Solana gas sponsorship (transaction fee only, never account rent).
# Endpoint form: https://solana.pimlico.io/v1/mainnet/rpc?apikey=<key>
#   (api.pimlico.io/v2/solana answers "chain solana is not supported" — measured.)
PIMLICO_API_KEY=""
# Solscan Pro — optional. The free tier returns 401 "Please upgrade your api key level" on every
# v2.0 endpoint, so nothing in this project depends on it. Present for completeness only.
SOLSCAN_API_KEY=""

# ---------------------------------------------------------------------------
# AI + media
# ---------------------------------------------------------------------------
# Bot brain + token optimisation (OpenAI-compatible endpoint). River: https://api.river.ai/v1
AI_BASE_URL=""
AI_API_KEY=""
AI_MODEL=""
# Image generation: Pollinations ONLY (owner's rule — no fal/MiniMax/OpenAI image models).
POLLINATIONS_API_KEY=""
POLLINATIONS_IMAGE_MODEL="black-forest-labs/flux.1-schnell"
POLLINATIONS_EDIT_MODEL="black-forest-labs/flux.1-kontext-pro"

# ---------------------------------------------------------------------------
# Deployment
# ---------------------------------------------------------------------------
# Filled in after the first Vercel deploy (the domain the app is served from).
# Used by links.ts to build absolute URLs for sharing (bots, Telegram) instead of bare paths.
NEXT_PUBLIC_APP_URL=""
# The platform's own coin, once it exists. Unset = the /token tab says "not published yet" and
# renders no address, no price and no buy link — on purpose, because a placeholder address is a
# string someone could paste into a wallet and act on.
NEXT_PUBLIC_PLATFORM_TOKEN_MINT=""
# Optional: the platform token's X handle, only used when the mint above is set.
NEXT_PUBLIC_PLATFORM_TOKEN_X=""

# ---------------------------------------------------------------------------
# Smoke scripts only (scripts/*.ts — never needed by the running app)
# ---------------------------------------------------------------------------
# node --env-file=.env.local scripts/create-smoke.ts        USER_PUBKEY, TEST_METADATA_URI
# node --env-file=.env.local scripts/fee-sharing-smoke.ts   AUTHORITY
# node --env-file=.env.local scripts/sponsored-smoke.ts     FEE_RECEIVER
USER_PUBKEY=""
AUTHORITY=""
FEE_RECEIVER=""
TEST_METADATA_URI=""
# Only for scripts/encrypt-treasury.ts, which produces TREASURY_KEYPAIR_ENCRYPTED.
TREASURY_PASSPHRASE=""
